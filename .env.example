# Public base URL, used for canonical/OG metadata, sitemap, and robots.
# Set to the real origin in production or the sitemap will emit localhost URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# APOD is sourced from the science.nasa.gov feed, which needs no API key.
# NASA_API_KEY is no longer required. (The api.nasa.gov gateway proved unreliable:
# intermittent 500s and invalid-key 403s.) Kept here only for reference.
NASA_API_KEY=

# Reserved for a future JPL provider (not used in the MVP; no JPL adapter exists yet).
JPL_USER_AGENT=apeiron-mvp/0.1 (contact@example.com)
